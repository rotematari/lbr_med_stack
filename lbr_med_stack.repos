# lbr_med_stack.repos - pinned vcs manifest for the KUKA LBR Med 7 R800 overlay.
# Pairs with FRI_CLIENT_VERSION=1.15 (matches Sunrise.OS Med 1.15).
# Usage:
#   vcs import src < lbr_med_stack.repos
#   rosdep install --from-paths src -i -r -y
#   colcon build --symlink-install
repositories:
  fri:
    type: git
    url: https://github.com/lbr-stack/fri
    # FRI 1.15 branch, pinned to the revision used by lbr-stack's FRI 1.15 manifest.
    version: dc7d613d42571e458dd62ea814a0a47a209487d8
  lbr_fri_idl:
    type: git
    url: https://github.com/lbr-stack/lbr_fri_idl
    # FRI 1 IDL branch, pinned to the revision used by lbr-stack's FRI 1.15 manifest.
    version: e422bff2b3d70ec47853145b35645980df623a60
  lbr_fri_ros2_stack:
    type: git
    url: https://github.com/lbr-stack/lbr_fri_ros2_stack.git
    version: jazzy-v2.4.3

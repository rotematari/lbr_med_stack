# colcon workspace artifacts and vcs-imported sources (never committed)
src/*
# ...except the first-party package, which is committed
!src/lbr_med_examples/
build/
install/
log/
# separate driver builds for live runs (kept across reboots, unlike /tmp)
overlays/

# python tooling caches
__pycache__/
.ruff_cache/

# Graphify generated outputs (rebuild locally; do not commit)
graphify-out/

# First-party offline acquisition package
!src/lbr_acquisition/
!src/lbr_acquisition/**

# First-party recording control interfaces
!src/lbr_recording_interfaces/
!src/lbr_recording_interfaces/**
